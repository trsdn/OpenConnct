{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "OpenConnct",
  "UUID": "com.trsdn.openconnct",
  "Author": "Torsten Mahr",
  "Version": "0.1.0.0",
  "Icon": "icons/plugin",
  "Category": "OpenConnct",
  "CategoryIcon": "icons/category",
  "CodePath": "plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13.0"
    }
  ],
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Description": "Mute, solo and set the level and gain of microphones in OpenConnct, and switch their filters, from a Stream Deck. Keys show what OpenConnct is actually doing, including changes made in the app window.",
  "Actions": [
    {
      "Name": "Toggle mute",
      "UUID": "com.trsdn.openconnct.mute",
      "Icon": "icons/mic",
      "Tooltip": "Mutes or unmutes one microphone. The key turns red while the microphone is muted and grey while it is unplugged.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "pi/mute.html",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "icons/mic-live",
          "Name": "Live",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/mic-muted",
          "Name": "Muted",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/mic-unavailable",
          "Name": "Unavailable",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Gain",
      "UUID": "com.trsdn.openconnct.gain",
      "Icon": "icons/gain",
      "Tooltip": "Raises or lowers one microphone's gain by a fixed step. The key shows the current gain in decibels.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "pi/gain.html",
      "States": [
        {
          "Image": "icons/gain",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Solo",
      "UUID": "com.trsdn.openconnct.solo",
      "Icon": "icons/solo",
      "Tooltip": "Solos one microphone: every other channel is silenced while it is on. The key is lit while the microphone is soloed.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "pi/solo.html",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "icons/solo",
          "Name": "Off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/solo-on",
          "Name": "On",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/solo-unavailable",
          "Name": "Unavailable",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Level",
      "UUID": "com.trsdn.openconnct.fader",
      "Icon": "icons/level",
      "Tooltip": "Raises or lowers one microphone's level in the mix by a fixed step. This is the fader you see in each channel strip, not the input gain.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "pi/fader.html",
      "States": [
        {
          "Image": "icons/level",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Filter",
      "UUID": "com.trsdn.openconnct.effect",
      "Icon": "icons/effect-off",
      "Tooltip": "Switches one stage of a microphone's chain on or off: high-pass filter, noise gate, compressor, exciter, bass enhancer or pad. The key is lit while it is on.",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "pi/effect.html",
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "icons/effect-off",
          "Name": "Off",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/effect-on",
          "Name": "On",
          "TitleAlignment": "bottom"
        },
        {
          "Image": "icons/effect-unavailable",
          "Name": "Unavailable",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
